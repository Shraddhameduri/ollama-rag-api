# Copy to .env and fill in. No secrets are committed — this file holds placeholders only.

# Ollama server base URL
OLLAMA_HOST=http://localhost:11434
# Chat model served by Ollama
OLLAMA_MODEL=llama3.2:1b
# Embedding model served by Ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Persistent ChromaDB directory
CHROMA_DIR=./data/chroma

# API key for X-API-Key auth on /v1/*. Empty = auth DISABLED (dev only).
API_KEY=

# Requests per minute, per API key (or per IP when auth is disabled)
RATE_LIMIT_PER_MIN=60

# Comma-separated allowed origins, e.g. https://app.example.com,http://localhost:3000
CORS_ORIGINS=

# Max document upload size in megabytes
MAX_UPLOAD_MB=25

# RAG chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
HISTORY_WINDOW=6

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
